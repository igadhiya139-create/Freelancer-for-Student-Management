<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="FreelanceStudentSystem.MasterPages.Site" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Student Freelancer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; font-size: 1.15rem; letter-spacing: 0.04em; display: flex; align-items: center; gap: 8px; }
        .navbar-brand .brand-icon { width: 34px; height: 34px; background: #1a73e8; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .navbar-brand .brand-icon svg { display: block; }
        .navbar-brand .brand-word { color: #fff; }
        .navbar-brand .brand-accent { color: #47b2e4; }
        .navbar { box-shadow: 0 2px 8px rgba(0,0,0,0.1); background-color: #2c4770 !important; }
        .main-content { min-height: calc(100vh - 120px); padding: 30px 0; }
        footer { background-color: #1e3a5f; color: #adb5bd; padding: 15px 0; text-align: center; }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" href="~/WebForm1.aspx" runat="server">
                    <span class="brand-icon">
                        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22">
                            <path d="M20 6L4 15l16 9 16-9L20 6z" fill="white"/>
                            <path d="M4 25l16 9 16-9" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                            <path d="M4 20l16 9 16-9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/>
                        </svg>
                    </span>
                    <span><span class="brand-word">STUDENT </span><span class="brand-accent">FREELANCER</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto">
                        <% if (Session["UserID"] != null) { %>
                            <% if (Session["UserType"].ToString() == "Student") { %>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Student/Dashboard.aspx" runat="server">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Student/BrowseProjects.aspx" runat="server">Browse Projects</a></li>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Student/MyApplications.aspx" runat="server">My Applications</a></li>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Student/Portfolio.aspx" runat="server">Portfolio</a></li>
                            <% } else if (Session["UserType"].ToString() == "Client") { %>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Client/Dashboard.aspx" runat="server">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Client/PostProject.aspx" runat="server">Post Project</a></li>
                            <% } else if (Session["UserType"].ToString() == "Admin") { %>
                                <li class="nav-item"><a class="nav-link" href="~/Pages/Admin/Dashboard.aspx" runat="server">Admin Panel</a></li>
                            <% } %>
                            <li class="nav-item">
                                <span class="nav-link" style="color:#ffd700 !important; font-weight:700;"><i class="bi bi-person-circle"></i> <%= Session["FullName"] %></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-light btn-sm ms-2" href="~/Pages/Account/Logout.aspx" runat="server">Logout</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link" href="~/Pages/Account/Login.aspx" runat="server">Login</a></li>
                            <li class="nav-item"><a class="nav-link" href="~/Pages/Account/Register.aspx" runat="server">Register</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <div class="container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

        <!-- Footer -->
        <footer>
            <div class="container">
                <p class="mb-0">&copy; <%= DateTime.Now.Year %> Student Freelancer &mdash; Built for students, by students.</p>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
