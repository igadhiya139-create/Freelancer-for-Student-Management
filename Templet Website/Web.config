<configuration>
  <!-- other sections (appSettings, connectionStrings, etc.) -->

  <system.net>
    <mailSettings>
      <smtp from="no-reply@example.com">
        <network host="smtp.example.com"
                 port="587"
                 userName="smtp-user"
                 password="smtp-pass"
                 enableSsl="true" />
      </smtp>
    </mailSettings>
  </system.net>

  <!-- remaining configuration -->
</configuration>

